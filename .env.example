# ──────────────────────────────────────────────────────────────────────────────
# .env.example  —  Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────────────────────────────────

# ── Application ────────────────────────────────────────────────────────────────
APP_NAME="Udaan Translation Microservice"
APP_VERSION="1.0.0"
DEBUG=False

# ── Server ─────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── Google Translate (optional) ────────────────────────────────────────────────
# Obtain from https://console.cloud.google.com/
# Leave blank to use the built-in mock translation engine.
GOOGLE_API_KEY=

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./udaan_logs.db
